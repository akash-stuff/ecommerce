# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- Multi-tenancy ----------------------------------------------------------
# Apex domain for tenant subdomains: {slug}.{PLATFORM_DOMAIN}
PLATFORM_DOMAIN=platform.localhost
# Hostnames that must NOT resolve to a tenant (admin console, bare API).
PLATFORM_ADMIN_HOSTS=localhost,admin.platform.localhost,api.platform.localhost

# ---- Data -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth (generate with: openssl rand -base64 48) --------------------------
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# ---- Tenant credential encryption (generate with: openssl rand -base64 32) ---
# Encrypts payment gateway secrets that stores enter themselves. Rotating this
# makes every stored gateway secret unreadable and every store has to reconnect,
# so keep it in a secret manager rather than in a repo.
CREDENTIALS_ENCRYPTION_KEY=replace-me-with-32-bytes-base64-encoded

# ---- CORS -------------------------------------------------------------------
# Global request throttle per client IP. Raise for load testing.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_TENANT_SUBDOMAINS=true

# ---- Email ------------------------------------------------------------------
# Leave SMTP_HOST blank and email is logged instead of sent.
#
# For Gmail or Google Workspace, set SMTP_SERVICE=gmail and the host and port
# are filled in (smtp.gmail.com:465). You need:
#   SMTP_USER      the full Gmail address
#   SMTP_PASSWORD  a 16-character App Password, NOT the account password.
#                  Requires 2-Step Verification, then
#                  https://myaccount.google.com/apppasswords
#   SMTP_FROM      leave blank to send as SMTP_USER. Gmail rewrites a From it
#                  has not verified, so a different value is silently ignored
#                  unless it is a verified alias.
# Gmail's free tier caps sending at roughly 500 messages a day; Workspace is
# 2,000. Above that use a transactional provider — see docs/DEPLOYMENT.md.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@platform.localhost

# ---- Payments ---------------------------------------------------------------
# Nothing to set here. Payment credentials are per store, not per platform: each
# tenant connects its own Razorpay account from Admin > Payments, so settlements
# reach that store's bank account rather than yours. They are held encrypted
# with CREDENTIALS_ENCRYPTION_KEY above.

# ---- SMS and WhatsApp (optional; email is sent regardless) -------------------
# Leave blank and those channels report themselves unconfigured rather than
# pretending to send. Both numbers are Twilio senders in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Applied to stored phone numbers that lack one, e.g. +91
SMS_DEFAULT_COUNTRY_CODE=+91

# ---- Object storage ---------------------------------------------------------
# With no bucket configured, uploads are written to STORAGE_LOCAL_DIR and served
# by this API at /uploads. That is right for development and wrong for more than
# one replica — see docs/DEPLOYMENT.md.
#
# S3 needs exactly these four together; any fewer and uploads silently keep
# going to local disk:
#   S3_BUCKET, S3_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#
# The IAM user needs only s3:PutObject and s3:DeleteObject on
# arn:aws:s3:::<bucket>/* — nothing else. Reads are served by the bucket policy
# or the CDN, not by these credentials.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials from an assumed IAM role.
AWS_SESSION_TOKEN=
# Set for an S3-compatible store (MinIO, Cloudflare R2, Spaces). Blank means AWS.
S3_ENDPOINT=
# Where stored files are fetched from. For S3 this is the CDN in front of the
# bucket; for local storage it is this API's own public address.
#
# Getting this wrong when S3 is on is the one failure with no error: uploads
# succeed and every stored URL 404s, with the wrong address written into the
# database for good. Leave it BLANK with S3 and the bucket URL is used. The API
# logs an error at boot if S3 is configured and this still points at localhost.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
