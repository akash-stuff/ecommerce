# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- Multi-tenancy ----------------------------------------------------------
# Apex domain for tenant subdomains: {slug}.{PLATFORM_DOMAIN}
PLATFORM_DOMAIN=platform.localhost
# Hostnames that must NOT resolve to a tenant (admin console, bare API).
PLATFORM_ADMIN_HOSTS=localhost,admin.platform.localhost,api.platform.localhost

# ---- Data -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth (generate with: openssl rand -base64 48) --------------------------
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_TENANT_SUBDOMAINS=true

# ---- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@platform.localhost

# ---- Payments ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Object storage ---------------------------------------------------------
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
