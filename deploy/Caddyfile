:80 {
    handle /api/* {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}
