{
    # Public HTTPS is handled by Cloudflare + host Nginx.
    # Caddy only receives HTTP on 127.0.0.1:8080.
    auto_https off
}

# ---------------------------------------------------------------------------
# Platform domain
# ---------------------------------------------------------------------------

{$PLATFORM_DOMAIN}, *.{$PLATFORM_DOMAIN} {

    # API
    handle /api/* {
        reverse_proxy backend:4000
    }

    # SEO
    handle /sitemap.xml {
        reverse_proxy backend:4000
    }

    handle /robots.txt {
        reverse_proxy backend:4000
    }

    # Frontend
    #
    # Do NOT send HTML pages to /__ssr for now.
    # The SSR endpoint currently returns an HTML shell without the Vite
    # JavaScript entry point, resulting in an empty #root.
    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}

# ---------------------------------------------------------------------------
# Custom tenant domains
# ---------------------------------------------------------------------------

:80 {

    # API
    handle /api/* {
        reverse_proxy backend:4000
    }

    # SEO
    handle /sitemap.xml {
        reverse_proxy backend:4000
    }

    handle /robots.txt {
        reverse_proxy backend:4000
    }

    # Frontend
    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format json
    }
}
