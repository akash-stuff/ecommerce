{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--prefix", "ecommerce-backend"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "ecommerce-frontend", "--", "--port", "5173"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
